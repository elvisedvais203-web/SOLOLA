# Environment
NODE_ENV=production

# Server Port (Render utilise souvent PORT injecté)
PORT=4000

# Database (PostgreSQL + Prisma) — une seule URL, pas la commande psql dans le champ mot de passe.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Redis (optionnel en prod) — URL complète depuis Render (commence par redis:// ou rediss://).
# Une valeur invalide ou vide ⇒ fallback mémoire (limites / prod dégradée acceptable pour petit trafic).
REDIS_URL=rediss://default:password@host:port

# Authentification : l’API n’expose que POST /auth/firebase/verify (+ /auth/refresh). L’UI utilise Firebase (Google, Apple, SMS).

# CORS : liste d’origines séparées par des virgules (frontend déployé).
CORS_ORIGIN=https://ton-frontend.onrender.com

# JWT — chaînes longues aléatoires en prod (min. 32 caractères).
JWT_ACCESS_SECRET=generate_strong_random_string_min_32_chars_for_access
JWT_REFRESH_SECRET=generate_strong_random_string_min_32_chars_for_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

PAYMENT_WEBHOOK_SECRET=generate_strong_random_string_min_32_chars_for_webhook

# Firebase Admin — au choix :
# A) JSON complet du compte de service (une ligne ou variable multiligne selon l’hébergeur)
FIREBASE_SERVICE_ACCOUNT_JSON=
# B) Sinon décomposer (si pas de JSON) :
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Bucket Storage (si tu utilises Firebase Storage côté serveur / scripts — pas obligatoire pour l’API JWT)
# FIREBASE_STORAGE_BUCKET=ton-projet.appspot.com

# Media
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mobile Money / Push (optionnel)
MM_AIRTEL_API_URL=
MM_AIRTEL_API_TOKEN=
MM_ORANGE_API_URL=
MM_ORANGE_API_TOKEN=
MM_MPESA_API_URL=
MM_MPESA_API_TOKEN=
MM_AFRICELL_API_URL=
MM_AFRICELL_API_TOKEN=
MM_AFRIMONEY_API_URL=
MM_AFRIMONEY_API_TOKEN=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Bootstrap superadmin au démarrage (une fois en prod, change le mot de passe applicatif).
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
