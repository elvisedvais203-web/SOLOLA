PORT=4100
PUBLIC_BASE_URL=http://localhost:4100

# Option A (recommended): inline JSON service account
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option B: path to the service account json file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Your Firebase project storage bucket (ex: my-project.appspot.com)
FIREBASE_STORAGE_BUCKET=

# If you want to accept only calls from your apps/web
ALLOWED_ORIGINS=http://localhost:3000

# Note:
# Upload/profile endpoints now require:
# - Authorization: Bearer <Firebase ID token>
# - X-Firebase-AppCheck: <App Check token>
