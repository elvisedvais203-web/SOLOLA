# Mode Firebase uniquement (Google, Apple, SMS) : même valeur que AUTH_FIREBASE_ONLY côté API.
# NEXT_PUBLIC_FIREBASE_AUTH_ONLY=1

# --- Backend (Render) : l’UI appelle /api sur le même domaine que le frontend ---
# Le route handler Next relaie vers le backend. Préfère API_PROXY_TARGET sur le service
# **web** : lu au runtime (pas besoin de rebuild si tu changes l’URL).
# Format : origine uniquement, sans /api (ex. https://solola-api.onrender.com)
API_PROXY_TARGET=https://ton-backend.onrender.com
# Fallback / SSR : peut être défini au build (NEXT_PUBLIC_* est figé au build)
NEXT_PUBLIC_API_URL=https://ton-backend.onrender.com/api
# Par défaut le navigateur utilise seulement /api (proxy). Décommenter pour appeler
# l’URL absolue du backend depuis le navigateur (nécessite CORS côté API).
# NEXT_PUBLIC_API_DIRECT=1
# Socket.IO (toujours vers l’hôte réel du backend, sans chemin /api)
NEXT_PUBLIC_SOCKET_URL=https://ton-backend.onrender.com

NEXT_PUBLIC_APP_NAME=Solola
NEXT_PUBLIC_PUSH_PUBLIC_KEY=

# Firebase (Console > Paramètres > Application web) — même projet que le backend Admin SDK.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optionnel (storage / FCM si tu les utilises plus tard)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Développement local (décommenter)
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Si tu oublies NEXT_PUBLIC_* au build, les valeurs par défaut sont dans :
# src/lib/nextalkdeployfallbacks.ts (à mettre à jour si tu changes de nom de service Render).
